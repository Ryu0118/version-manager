{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/ryu/Programing/Swift/MyLibrary/version-manager/.codex/hooks/pre-commit-lint.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "make format"
          },
          {
            "type": "command",
            "command": "'/Users/ryu/Programing/Swift/MyLibrary/version-manager/.codex/hooks/post-edit-lint.sh'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cat | sh '/Users/ryu/Programing/Swift/MyLibrary/version-manager/.codex/hooks/gitnagg-check.sh'"
          }
        ]
      }
    ]
  }
}
